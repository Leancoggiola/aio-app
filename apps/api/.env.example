# PostgreSQL (Docker Compose default: postgresql://aio:aio_dev@localhost:5432/aio_app)
DATABASE_URL=postgresql://aio:aio_dev@localhost:5432/aio_app

# JWT
JWT_ACCESS_SECRET=access
JWT_REFRESH_SECRET=refresh
JWT_ACCESS_EXPIRES_IN=time_m
JWT_REFRESH_EXPIRES_IN=time_d

# Cookie (seconds, 604800 = 7 days)
COOKIE_REFRESH_MAX_AGE=604800

# Server
PORT=3000

# CORS (optional; set to frontend origin in production, or leave unset for development)
# CORS_ORIGIN=http://localhost:3001

TMDB_API_KEY=api_key_TMDB