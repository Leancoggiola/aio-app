{
  "name": "@aio-app/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./types/media": "./src/types/media.types.ts",
    "./types/user": "./src/types/user.types.ts",
    "./types/auth": "./src/types/auth.types.ts",
    "./dtos": "./src/dtos/index.ts",
    "./dtos/media": "./src/dtos/media.dto.ts",
    "./dtos/auth": "./src/dtos/auth.dto.ts",
    "./constants": "./src/constants/index.ts",
    "./constants/media": "./src/constants/media.constants.ts"
  },
  "typesVersions": {
    "*": {
      "types": ["src/types/index.ts"],
      "types/media": ["src/types/media.types.ts"],
      "types/user": ["src/types/user.types.ts"],
      "types/auth": ["src/types/auth.types.ts"],
      "dtos": ["src/dtos/index.ts"],
      "dtos/media": ["src/dtos/media.dto.ts"],
      "dtos/auth": ["src/dtos/auth.dto.ts"],
      "constants": ["src/constants/index.ts"],
      "constants/media": ["src/constants/media.constants.ts"]
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "typescript": "^5.5.4"
  }
}
