{
  "name": "@aio-app/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./media": "./src/media/index.ts",
    "./users": "./src/users/index.ts"
  },
  "typesVersions": {
    "*": {
      "auth": [
        "src/auth/index.ts"
      ],
      "media": [
        "src/media/index.ts"
      ],
      "users": [
        "src/users/index.ts"
      ]
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@aio-app/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "typescript": "6.0.3"
  }
}
