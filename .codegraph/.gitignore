# CodeGraph data files — local to each machine, not for committing.
# Ignore everything in .codegraph/ except tracked meta files, so transient
# files (the database, daemon.pid, sockets, logs) never show up in git.
# Keep in sync with root .gitignore (!.codegraph/README.md, !.codegraph/.gitignore).
*
!.gitignore
!README.md
